{
  "name": "@aihu/context",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ssr": {
      "import": "./dist/ssr.js",
      "types": "./dist/ssr.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome ci .",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:release-contract": "node scripts/release-contract-regression.mjs",
    "release:contract": "node scripts/verify-pack.mjs",
    "prepublishOnly": "npm run build"
  },
  "description": "Async-context-friendly request/SSR context primitives for aihu.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-context.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-context#readme",
  "bugs": "https://github.com/aihu-project/aihu-context/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
